{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "node build.mjs",
  "outputDirectory": "dist",
  "cleanUrls": true,
  "redirects": [
    {
      "source": "/lab/files/index",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/lab/files/index.html",
      "destination": "/",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/",
      "has": [
        {
          "type": "query",
          "key": "lang",
          "value": "(?<lang>zh|en|es|fr|de|ru|ar|hi|ja)"
        }
      ],
      "destination": "/_l/:lang/home"
    },
    {
      "source": "/p/:n(\\d{1,2})",
      "has": [
        {
          "type": "query",
          "key": "lang",
          "value": "(?<lang>zh|en|es|fr|de|ru|ar|hi|ja)"
        }
      ],
      "destination": "/_l/:lang/p/:n"
    },
    {
      "source": "/:page(intro|sandbox|about|privacy|contact)",
      "has": [
        {
          "type": "query",
          "key": "lang",
          "value": "(?<lang>zh|en|es|fr|de|ru|ar|hi|ja)"
        }
      ],
      "destination": "/_l/:lang/:page"
    },
    {
      "source": "/lab/:slug([a-z0-9-]+)",
      "has": [
        {
          "type": "query",
          "key": "lang",
          "value": "(?<lang>zh|en|es|fr|de|ru|ar|hi|ja)"
        }
      ],
      "destination": "/_l/:lang/lab/:slug"
    },
    {
      "source": "/",
      "destination": "/_l/x/home"
    },
    {
      "source": "/p/:n(\\d{1,2})",
      "destination": "/_l/x/p/:n"
    },
    {
      "source": "/:page(intro|sandbox|about|privacy|contact)",
      "destination": "/_l/x/:page"
    },
    {
      "source": "/lab/:slug([a-z0-9-]+)",
      "destination": "/_l/x/lab/:slug"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    }
  ]
}
